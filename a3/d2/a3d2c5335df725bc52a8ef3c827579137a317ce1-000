# 23 October 2026: lighten the V5 mockup. Latin subsets of the three fonts (Japanese falls back to Hiragino, already on the Mac),
# and an AVIF wallpaper at 1600 px, CRF 25 (Toolbox1.md sweet spot). Originals are kept.
import subprocess, sys
from pathlib import Path
from fontTools import subset
D = Path(sys.argv[1])
LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'
for name in ['InterVariable', 'AnthropicSerif-Romans', 'GT-Sectra-LCGV-Regular']:
    o = subset.Options(); o.flavor = 'woff2'; o.layout_features = ['*']; o.name_IDs = ['*']; o.notdef_outline = True
    f = subset.load_font(str(D / 'fonts' / f'{name}.woff2'), o)
    s = subset.Subsetter(o); s.populate(unicodes=subset.parse_unicodes(LATIN)); s.subset(f)
    subset.save_font(f, str(D / 'fonts' / f'{name}-latin.woff2'), o)
subprocess.run(['sips', '-Z', '1600', '-s', 'format', 'png', str(D / 'wallpaper.webp'), '--out', str(D / 'Scripts' / '_wall.png')], check=True, capture_output=True)
subprocess.run(['avifenc', '--min', '25', '--max', '25', '--speed', '6', str(D / 'Scripts' / '_wall.png'), str(D / 'wallpaper-1600.avif')], check=True, capture_output=True)
(D / 'Scripts' / '_wall.png').unlink()
print('LATIN', LATIN)
