  </main>
</div>

<div class="panel min" id="panel">
  <div class="top"><b>Paramètres</b><button id="min">–</button></div>
  <label style="grid-template-columns:1fr 1fr">Titres<select id="fam"><option value="sectra">GT Sectra LCG</option><option value="anthropic">Anthropic Serif</option></select></label>
  <label style="grid-template-columns:1fr 1fr">Questions<select id="qt"><option value="title">Comme titres</option><option value="body">Comme corps</option></select></label>
  <div id="sliders"></div>
  <button class="btn pri copy" id="copy">Copier les valeurs pour le prompt</button>
</div>

<script>
// 23 October 2026 10:55: sliders write only :root variables (HDA interface, 8 max).
const PARAMS = [
  ['--col-max', 560, 1000, 10, 'px', 'Largeur de colonne'],
  ['--q-size', 14, 26, .5, 'px', 'Taille question'],
  ['--a-size', 13, 20, .5, 'px', 'Taille réponse'],
  ['--answer-lines', 2, 12, 1, '', 'Lignes de réponse visibles'],
  ['--radius', 0, 28, 1, 'px', 'Arrondi'],
  ['--gap', 4, 32, 1, 'px', 'Espace entre cartes'],
  ['--accent-h', 0, 360, 1, '', 'Teinte accent'],
  ['--glass', .3, 1, .01, '', 'Opacité verre'],
]
const root = document.documentElement, box = document.getElementById('sliders')
for (const [v, min, max, step, unit, label] of PARAMS) {
  const cur = parseFloat(getComputedStyle(root).getPropertyValue(v))
  const l = document.createElement('label')
  l.innerHTML = `${label}<span class="num">${cur}</span><input type="range" min="${min}" max="${max}" step="${step}" value="${cur}">`
  l.querySelector('input').oninput = (e) => { root.style.setProperty(v, e.target.value + unit); l.querySelector('span').textContent = e.target.value }
  box.appendChild(l)
}
// 23 October 2026 13:40: titles GT Sectra LCG Regular upright, numbers always Anthropic Serif (wrapped automatically), body Anthropic.
const FAMILIES = { sectra: "'GT Sectra LCG', var(--zr-police-serif)", anthropic: 'var(--zr-police-serif)' }
const fam = document.getElementById('fam'), qt = document.getElementById('qt')
const applyType = () => { root.style.setProperty('--zr-police-titres', FAMILIES[fam.value]); root.style.setProperty('--zr-style-titres', 'normal'); document.body.classList.toggle('q-title', qt.value === 'title') }
fam.onchange = qt.onchange = applyType
applyType()
// Wrap every digit run inside a title in .num, so "22 October" mixes Anthropic (22) and Sectra (October).
for (const el of document.querySelectorAll('.q, .day b, .hero h1')) {
  const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT), nodes = []
  while (walker.nextNode()) if (/\d/.test(walker.currentNode.nodeValue) && !walker.currentNode.parentElement.closest('.num')) nodes.push(walker.currentNode)
  for (const n of nodes) { const span = document.createElement('span'); span.innerHTML = n.nodeValue.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]).replace(/(\d[\d:.,]*)/g, '<span class="num">$1</span>'); n.replaceWith(...span.childNodes) }
}
document.getElementById('copy').onclick = () => {
  const view = document.querySelector('.switch .on').textContent.trim()
  const vals = PARAMS.map(([v]) => `${v}: ${getComputedStyle(root).getPropertyValue(v).trim()}`).join('; ') + `; titres: ${fam.selectedOptions[0].text}; questions: ${qt.selectedOptions[0].text}; chiffres: Anthropic Serif`
  navigator.clipboard.writeText(`Knowledge design ${view} ; ${vals}`)
}
document.getElementById('min').onclick = () => document.getElementById('panel').classList.toggle('min')
document.querySelectorAll('.switch button').forEach((b) => b.onclick = () => {
  document.querySelectorAll('.switch button').forEach((x) => x.classList.toggle('on', x === b))
  document.querySelectorAll('.view').forEach((s) => s.classList.toggle('on', s.id === 'v-' + b.dataset.v))
})
document.querySelectorAll('.list .row').forEach((r) => r.onclick = () => document.querySelectorAll('.list .row').forEach((x) => x.classList.toggle('on', x === r)))
</script>
</body>
</html>
